# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_db

# Gemini Vision API Key (Optional: If empty, local OCR will be used automatically)
GEMINI_API_KEY=

# Login (required). Generate SESSION_SECRET with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_HOURS=8
# Set to false only when testing over plain http://localhost
COOKIE_SECURE=true
