# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_db

# Gemini Vision API Key (Optional: If empty, local OCR will be used automatically)
GEMINI_API_KEY=

# Login: ADMIN_USERNAME/ADMIN_PASSWORD create the FIRST admin on startup, only while no users exist.
# After that, manage users inside the app (Admin > Users).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sysadmin: the only role that can open "System Settings" (e.g. set the Gemini key in the UI).
# Created once on startup if the account does not exist yet. Min 8 characters.
SYSADMIN_USERNAME=sysadmin
SYSADMIN_PASSWORD=

# Required (min 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HOURS=8

# Set to false only when testing over plain http://localhost
COOKIE_SECURE=true
